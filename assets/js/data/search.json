---
layout: compress
swcache: true
---

{%- comment -%}
  This site's change: tabs and pages with the page layout are searchable too, not
  only posts. Listing tabs such as Blog and Tags are left out, as their content is
  generated, and so are pages kept out of the sitemap.
{%- endcomment -%}
{%- assign pages = site.tabs | concat: site.pages | where: 'layout', 'page' | where_exp: 'item', 'item.sitemap != false' -%}
{%- assign entries = site.posts | concat: pages -%}

[
  {% for post in entries %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ post.categories | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date": {{ post.date | jsonify }},
    {% capture content -%}{% include post-summary.html full_text=true %}{%- endcapture -%}
    "content": {{ content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
